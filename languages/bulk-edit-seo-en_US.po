msgid "%d فیلتر تگزونومی"
msgstr "%d taxonomy filters"

msgid "%d فیلتر متافیلد"
msgstr "%d meta-field filters"

msgid "-- انتخاب کنید --"
msgstr "-- Select --"

msgid "<strong>Alt Text:</strong> متن جایگزین به صورت خودکار از عنوان محصول پر می‌شود"
msgstr "<strong>Alt Text:</strong> the alternative text is auto-filled from the product title"

msgid "<strong>No Index/Follow:</strong> برای جلوگیری از ایندکس یا فالو لینک‌ها تیک بزنید"
msgstr "<strong>No Index/Follow:</strong> check these to prevent indexing or following links"

msgid "<strong>Variations:</strong> تغییرات روی Variations بلافاصله روی محصول اصلی تاثیر می‌گذارد"
msgstr "<strong>Variations:</strong> changes to variations apply to the main product immediately"

msgid "<strong>اسکرول:</strong> هر سطر به صورت مستقل اسکرول افقی دارد"
msgstr "<strong>Scroll:</strong> each row scrolls horizontally on its own"

msgid "<strong>انتخاب فیلدها:</strong> فیلدهایی که می‌خواهید ویرایش کنید را فعال کنید"
msgstr "<strong>Choose fields:</strong> enable the fields you want to edit"

msgid "<strong>انتخاب پست‌تایپ:</strong> ابتدا از تنظیمات، نوع پست مورد نظر را انتخاب کنید"
msgstr "<strong>Choose post type:</strong> first pick the post type you want in Settings"

msgid "<strong>انتخاب گروهی:</strong> با چک‌باکس «انتخاب همه» می‌توانید چند آیتم را همزمان انتخاب کنید"
msgstr "<strong>Bulk select:</strong> use the “Select all” checkbox to select several items at once"

msgid "<strong>تصاویر:</strong> تصاویر با نام یکسان جایگزین می‌شوند و قدیمی کاملاً حذف می‌شود"
msgstr "<strong>Images:</strong> images with the same name are replaced and the old one is fully deleted"

msgid "<strong>تصویر Variation:</strong> هر Variation می‌تواند تصویر مخصوص خود را داشته باشد"
msgstr "<strong>Variation image:</strong> each variation can have its own image"

msgid "<strong>تصویر شاخص:</strong> روی باکس تصویر کلیک کنید تا تصویر جدید انتخاب کنید"
msgstr "<strong>Featured image:</strong> click the image box to pick a new image"

msgid "<strong>تغییر پست‌تایپ:</strong> برای کار با پست‌تایپ دیگر به تنظیمات بروید"
msgstr "<strong>Switch post type:</strong> go to Settings to work with another post type"

msgid "<strong>توجه:</strong> جایگزینی و کپی ستون فقط در مرورگر اعمال می‌شوند؛ برای ثبت نهایی حتماً «ذخیره تغییرات» را بزنید"
msgstr "<strong>Note:</strong> find & replace and fill-down are applied in the browser only; be sure to click “Save changes” to persist them"

msgid "<strong>توضیحات سئو:</strong> Meta Description برای نتایج گوگل"
msgstr "<strong>SEO description:</strong> Meta Description for Google results"

msgid "<strong>تگزونومی:</strong> فیلتر بر اساس دسته‌بندی و برچسب"
msgstr "<strong>Taxonomy:</strong> filter by category and tag"

msgid "<strong>جایگزینی خودکار:</strong> تصویر قدیمی با همان نام به طور خودکار حذف و جایگزین می‌شود"
msgstr "<strong>Auto-replace:</strong> the old image with the same name is automatically deleted and replaced"

msgid "<strong>جستجو:</strong> در عنوان و محتوا جستجو کنید"
msgstr "<strong>Search:</strong> search in title and content"

msgid "<strong>جست‌وجو و جایگزینی:</strong> در یک ستون مشخص، یک عبارت را در همه‌ی ردیف‌ها پیدا و جایگزین می‌کند"
msgstr "<strong>Find & replace:</strong> finds and replaces a term across all rows in a chosen column"

msgid "<strong>خروجی CSV:</strong> ردیف‌های فیلترشده‌ی فعلی را با ستون فیلدهای انتخابی دانلود می‌کند (با BOM برای نمایش درست فارسی در Excel)"
msgstr "<strong>Export CSV:</strong> downloads the currently filtered rows with the selected field columns (with a BOM so Persian displays correctly in Excel)"

msgid "<strong>ذخیره تغییرات:</strong> حتماً پس از ویرایش دکمه ذخیره را بزنید"
msgstr "<strong>Save changes:</strong> always click Save after editing"

msgid "<strong>ذخیره نهایی:</strong> حتماً دکمه «ذخیره تغییرات» را بزنید"
msgstr "<strong>Final save:</strong> be sure to click the “Save changes” button"

msgid "<strong>شبکه‌های اجتماعی:</strong> ویرایش عنوان و توضیحات OpenGraph و توییتر (بر اساس پلاگین سئوی فعال)"
msgstr "<strong>Social networks:</strong> edit OpenGraph and Twitter title and description (based on the active SEO plugin)"

msgid "<strong>عملیات گروهی:</strong> از منوی Bulk Actions برای تغییر وضعیت یا حذف گروهی استفاده کنید"
msgstr "<strong>Bulk actions:</strong> use the Bulk Actions menu to change status or delete in bulk"

msgid "<strong>عنوان سئو:</strong> عنوان متا را برای موتورهای جستجو تنظیم کنید"
msgstr "<strong>SEO title:</strong> set the meta title for search engines"

msgid "<strong>فیلتر کردن:</strong> از فیلترها برای یافتن سریع‌تر آیتم‌های خاص استفاده کنید"
msgstr "<strong>Filtering:</strong> use filters to find specific items faster"

msgid "<strong>قیمت‌گذاری:</strong> قیمت و موجودی هر Variation به صورت مجزا قابل تنظیم است"
msgstr "<strong>Pricing:</strong> price and stock of each variation can be set independently"

msgid "<strong>متافیلدها:</strong> فیلترهای پیشرفته متافیلدهای سفارشی (دکمه «فیلترهای پیشرفته»)"
msgstr "<strong>Meta fields:</strong> advanced custom meta-field filters (the “Advanced filters” button)"

msgid "<strong>نمایش Variations:</strong> روی دکمه فلش کنار شناسه کلیک کنید"
msgstr "<strong>Show variations:</strong> click the arrow button next to the ID"

msgid "<strong>نوع محصول:</strong> فیلتر محصولات ساده، متغیر، گروهی و..."
msgstr "<strong>Product type:</strong> filter simple, variable, grouped products, etc."

msgid "<strong>ورود CSV:</strong> همان فایل را پس از ویرایش در Excel/Sheets آپلود کنید؛ بر اساس ستون <code>ID</code> آیتم‌ها به‌روزرسانی می‌شوند"
msgstr "<strong>Import CSV:</strong> upload the same file after editing it in Excel/Sheets; items are updated based on the <code>ID</code> column"

msgid "<strong>وضعیت:</strong> فیلتر بر اساس منتشر شده، پیش‌نویس، خصوصی و..."
msgstr "<strong>Status:</strong> filter by published, draft, private, etc."

msgid "<strong>ویرایش Alt:</strong> می‌توانید Alt Text را دستی ویرایش کنید"
msgstr "<strong>Edit Alt:</strong> you can edit the Alt Text manually"

msgid "<strong>ویرایش مستقل:</strong> هر Variation (سایز، رنگ و...) قابل ویرایش جداگانه است"
msgstr "<strong>Independent editing:</strong> each variation (size, color, etc.) can be edited separately"

msgid "<strong>ویرایش مستقیم:</strong> فیلدها را مستقیماً در جدول ویرایش کنید"
msgstr "<strong>Inline editing:</strong> edit fields directly in the table"

msgid "<strong>کلمه کلیدی:</strong> Focus Keyword خود را تعیین کنید"
msgstr "<strong>Keyword:</strong> set your Focus Keyword"

msgid "<strong>کپی به کل ستون (Fill-down):</strong> یک مقدار را روی تمام ردیف‌های یک ستون می‌ریزد"
msgstr "<strong>Fill-down:</strong> applies one value to every row in a column"

msgid "<strong>گالری:</strong> روی دکمه + کلیک کنید تا تصاویر گالری اضافه کنید"
msgstr "<strong>Gallery:</strong> click the + button to add gallery images"

msgid "<strong>یکپارچگی کامل:</strong> پلاگین با Yoast SEO، Rank Math و SEOPress کار می‌کند"
msgstr "<strong>Full integration:</strong> the plugin works with Yoast SEO, Rank Math and SEOPress"

