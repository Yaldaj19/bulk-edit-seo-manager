msgid "<strong>Alt Text:</strong> متن جایگزین به صورت خودکار از عنوان محصول پر می‌شود"
msgstr ""

msgid "<strong>No Index/Follow:</strong> برای جلوگیری از ایندکس یا فالو لینک‌ها تیک بزنید"
msgstr ""

msgid "<strong>Variations:</strong> تغییرات روی Variations بلافاصله روی محصول اصلی تاثیر می‌گذارد"
msgstr ""

msgid "<strong>اسکرول:</strong> هر سطر به صورت مستقل اسکرول افقی دارد"
msgstr ""

msgid "<strong>انتخاب فیلدها:</strong> فیلدهایی که می‌خواهید ویرایش کنید را فعال کنید"
msgstr ""

msgid "<strong>انتخاب پست‌تایپ:</strong> ابتدا از تنظیمات، نوع پست مورد نظر را انتخاب کنید"
msgstr ""

msgid "<strong>انتخاب گروهی:</strong> با چک‌باکس «انتخاب همه» می‌توانید چند آیتم را همزمان انتخاب کنید"
msgstr ""

msgid "<strong>تصاویر:</strong> تصاویر با نام یکسان جایگزین می‌شوند و قدیمی کاملاً حذف می‌شود"
msgstr ""

msgid "<strong>تصویر Variation:</strong> هر Variation می‌تواند تصویر مخصوص خود را داشته باشد"
msgstr ""

msgid "<strong>تصویر شاخص:</strong> روی باکس تصویر کلیک کنید تا تصویر جدید انتخاب کنید"
msgstr ""

msgid "<strong>تغییر پست‌تایپ:</strong> برای کار با پست‌تایپ دیگر به تنظیمات بروید"
msgstr ""

msgid "<strong>توجه:</strong> جایگزینی و کپی ستون فقط در مرورگر اعمال می‌شوند؛ برای ثبت نهایی حتماً «ذخیره تغییرات» را بزنید"
msgstr ""

msgid "<strong>توضیحات سئو:</strong> Meta Description برای نتایج گوگل"
msgstr ""

msgid "<strong>تگزونومی:</strong> فیلتر بر اساس دسته‌بندی و برچسب"
msgstr ""

msgid "<strong>جایگزینی خودکار:</strong> تصویر قدیمی با همان نام به طور خودکار حذف و جایگزین می‌شود"
msgstr ""

msgid "<strong>جستجو:</strong> در عنوان و محتوا جستجو کنید"
msgstr ""

msgid "<strong>جست‌وجو و جایگزینی:</strong> در یک ستون مشخص، یک عبارت را در همه‌ی ردیف‌ها پیدا و جایگزین می‌کند"
msgstr ""

msgid "<strong>خروجی CSV:</strong> ردیف‌های فیلترشده‌ی فعلی را با ستون فیلدهای انتخابی دانلود می‌کند (با BOM برای نمایش درست فارسی در Excel)"
msgstr ""

msgid "<strong>ذخیره تغییرات:</strong> حتماً پس از ویرایش دکمه ذخیره را بزنید"
msgstr ""

msgid "<strong>ذخیره نهایی:</strong> حتماً دکمه «ذخیره تغییرات» را بزنید"
msgstr ""

msgid "<strong>شبکه‌های اجتماعی:</strong> ویرایش عنوان و توضیحات OpenGraph و توییتر (بر اساس پلاگین سئوی فعال)"
msgstr ""

msgid "<strong>عملیات گروهی:</strong> از منوی Bulk Actions برای تغییر وضعیت یا حذف گروهی استفاده کنید"
msgstr ""

msgid "<strong>عنوان سئو:</strong> عنوان متا را برای موتورهای جستجو تنظیم کنید"
msgstr ""

msgid "<strong>فیلتر کردن:</strong> از فیلترها برای یافتن سریع‌تر آیتم‌های خاص استفاده کنید"
msgstr ""

msgid "<strong>قیمت‌گذاری:</strong> قیمت و موجودی هر Variation به صورت مجزا قابل تنظیم است"
msgstr ""

msgid "<strong>متافیلدها:</strong> فیلترهای پیشرفته متافیلدهای سفارشی (دکمه «فیلترهای پیشرفته»)"
msgstr ""

msgid "<strong>نمایش Variations:</strong> روی دکمه فلش کنار شناسه کلیک کنید"
msgstr ""

msgid "<strong>نوع محصول:</strong> فیلتر محصولات ساده، متغیر، گروهی و..."
msgstr ""

msgid "<strong>ورود CSV:</strong> همان فایل را پس از ویرایش در Excel/Sheets آپلود کنید؛ بر اساس ستون <code>ID</code> آیتم‌ها به‌روزرسانی می‌شوند"
msgstr ""

msgid "<strong>وضعیت:</strong> فیلتر بر اساس منتشر شده، پیش‌نویس، خصوصی و..."
msgstr ""

msgid "<strong>ویرایش Alt:</strong> می‌توانید Alt Text را دستی ویرایش کنید"
msgstr ""

msgid "<strong>ویرایش مستقل:</strong> هر Variation (سایز، رنگ و...) قابل ویرایش جداگانه است"
msgstr ""

msgid "<strong>ویرایش مستقیم:</strong> فیلدها را مستقیماً در جدول ویرایش کنید"
msgstr ""

msgid "<strong>کلمه کلیدی:</strong> Focus Keyword خود را تعیین کنید"
msgstr ""

msgid "<strong>کپی به کل ستون (Fill-down):</strong> یک مقدار را روی تمام ردیف‌های یک ستون می‌ریزد"
msgstr ""

msgid "<strong>گالری:</strong> روی دکمه + کلیک کنید تا تصاویر گالری اضافه کنید"
msgstr ""

msgid "<strong>یکپارچگی کامل:</strong> پلاگین با Yoast SEO، Rank Math و SEOPress کار می‌کند"
msgstr ""

